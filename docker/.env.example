# Optional local overrides for docker/compose.sqmu.yml.
# Copy to docker/.env for private local changes. docker/.env is ignored by git.
# These are development-only placeholders, not production credentials.

SQMU_ANVIL_PORT=8545
SQMU_WORDPRESS_PORT=18080
SQMU_OTTERSCAN_PORT=5103

SQMU_WORDPRESS_DB_NAME=wordpress
SQMU_WORDPRESS_DB_USER=wordpress
SQMU_WORDPRESS_DB_PASSWORD=sqmu_dev_password_change_me
SQMU_WORDPRESS_DB_ROOT_PASSWORD=sqmu_root_dev_password_change_me
