{
  "name": "sqmu-contracts",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "export:abi": "node scripts/export-abis.cjs",
    "bundle:contracts": "node scripts/build-contract-bundle.cjs",
    "smoke:deploy:anvil": "node scripts/smoke-deploy-anvil.cjs",
    "verify": "npm run compile && npm test",
    "build": "npm run compile && npm run export:abi && npm run bundle:contracts",
    "ci:contracts": "npm run compile && npm test && npm run export:abi && npm run bundle:contracts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "ethers": "^6.15.0",
    "hardhat": "^2.22.18"
  }
}
